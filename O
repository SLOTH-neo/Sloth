local Players = game:GetService("Players")
local LP = Players.LocalPlayer

local Whitelist = {
    ["Zn6xx"] = true,
    ["jay04_23"] = true,
}

-- 檢查白名單
if not Whitelist[LP.Name] then
    LP:Kick("你不在白名單，無法使用此腳本")
    return
end

-- 白名單通過，載入主腳本
local success, code = pcall(function()
    return game:HttpGet("https://raw.githubusercontent.com/SLOTH-neo/Sloth/refs/heads/main/NEKO")
end)

if success and code and #code > 100 then
    local func = loadstring(code)
    if func then
        func()
    end
else
    LP:Kick("腳本載入失敗，請稍後再試")
end
