local library = {}
local services = setmetatable({}, { __index = function(_, k) return game:GetService(k) end })
local ts = services.TweenService
local lplr = services.Players.LocalPlayer
local playerGui = lplr:WaitForChild("PlayerGui")

local function Tween(obj, info, prop)
    local t = ts:Create(obj, TweenInfo.new(unpack(info)), prop)
    t:Play()
    return t
end

local C = {
    Accent     = Color3.fromRGB(255, 105, 180),
    MainBG     = Color3.fromRGB(10, 10, 10),    
    BtnBG      = Color3.fromRGB(255, 255, 255), 
    Text       = Color3.fromRGB(150, 150, 150), 
    TextHi     = Color3.fromRGB(255, 255, 255), 
}

function library.new(name)
    local old = playerGui:FindFirstChild("yuzia_X")
    if old then old:Destroy() end

    local sg = Instance.new("ScreenGui", playerGui)
    sg.Name = "yuzia_X"
    sg.ResetOnSpawn = false

    local Main = Instance.new("Frame", sg)
    Main.Size = UDim2.new(0, 620, 0, 440)
    Main.Position = UDim2.new(0.5, -310, 0.5, -220)
    Main.BackgroundColor3 = C.MainBG
    Main.BackgroundTransparency = 0.15
    Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 12)
    local MainStroke = Instance.new("UIStroke", Main)
    MainStroke.Thickness = 1.2; MainStroke.Color = C.Accent; MainStroke.Transparency = 0.6

    local NameBox = Instance.new("Frame", Main)
    NameBox.Size = UDim2.new(0, 150, 0, 50); NameBox.BackgroundTransparency = 1
    local Title = Instance.new("TextLabel", NameBox)
    Title.Size = UDim2.new(1, 0, 1, 0); Title.Text = name; Title.TextColor3 = C.Accent; Title.Font = Enum.Font.GothamBold; Title.TextSize = 18; Title.BackgroundTransparency = 1

    local TopBar = Instance.new("Frame", Main)
    TopBar.Size = UDim2.new(1, -160, 0, 50); TopBar.Position = UDim2.new(0, 155, 0, 0); TopBar.BackgroundTransparency = 1
    local tl = Instance.new("UIListLayout", TopBar); tl.FillDirection = Enum.FillDirection.Horizontal; tl.VerticalAlignment = Enum.VerticalAlignment.Center; tl.Padding = UDim.new(0, 15)

    local SideBar = Instance.new("Frame", Main)
    SideBar.Size = UDim2.new(0, 150, 1, -70); SideBar.Position = UDim2.new(0, 10, 0, 60); SideBar.BackgroundColor3 = Color3.fromRGB(0,0,0); SideBar.BackgroundTransparency = 0.6
    Instance.new("UICorner", SideBar).CornerRadius = UDim.new(0, 10)
    local sl = Instance.new("UIListLayout", SideBar); sl.Padding = UDim.new(0, 5); sl.HorizontalAlignment = Enum.HorizontalAlignment.Center
    Instance.new("UIPadding", SideBar).PaddingTop = UDim.new(0, 10)

    local Pages = Instance.new("Frame", Main)
    Pages.Size = UDim2.new(1, -180, 1, -70); Pages.Position = UDim2.new(0, 170, 0, 60); Pages.BackgroundTransparency = 1

    local window = { currentMain = nil, currentSub = nil }

    function window:Toggle(state)
        if state ~= nil then sg.Enabled = state else sg.Enabled = not sg.Enabled end
    end

    function window:MainTab(mName)
        local mBtn = Instance.new("TextButton", TopBar)
        mBtn.Size = UDim2.new(0, 100, 0, 35); mBtn.BackgroundTransparency = 1; mBtn.Text = mName; mBtn.TextColor3 = C.Text; mBtn.Font = Enum.Font.GothamBold; mBtn.TextSize = 14
        
        local mLine = Instance.new("Frame", mBtn)
        mLine.Size = UDim2.new(0, 0, 0, 2); mLine.Position = UDim2.new(0.5, 0, 1, -5); mLine.AnchorPoint = Vector2.new(0.5, 0); mLine.BackgroundColor3 = C.Accent; mLine.BorderSizePixel = 0
        local mGlow = Instance.new("UIStroke", mLine); mGlow.Color = C.Accent; mGlow.Thickness = 2; mGlow.Transparency = 0.5

        local subList = {}
        local mainInst = {}

        function mainInst:SubTab(sName)
            local sBtn = Instance.new("TextButton", SideBar)
            sBtn.Size = UDim2.new(1, -20, 0, 38); sBtn.BackgroundColor3 = C.BtnBG; sBtn.BackgroundTransparency = 0.95; sBtn.Text = sName; sBtn.TextColor3 = C.Text; sBtn.Font = Enum.Font.GothamMedium; sBtn.TextSize = 13; sBtn.Visible = false
            Instance.new("UICorner", sBtn).CornerRadius = UDim.new(0, 8)
            local sIndicator = Instance.new("Frame", sBtn)
            sIndicator.Size = UDim2.new(0, 2, 0, 0); sIndicator.Position = UDim2.new(0, 0, 0.5, 0); sIndicator.AnchorPoint = Vector2.new(0, 0.5); sIndicator.BackgroundColor3 = C.Accent; sIndicator.BorderSizePixel = 0

            local Page = Instance.new("ScrollingFrame", Pages)
            Page.Size = UDim2.new(1, 0, 1, 0); Page.ScrollBarThickness = 0; Page.BackgroundTransparency = 1; Page.Visible = false
            local pl = Instance.new("UIListLayout", Page); pl.Padding = UDim.new(0, 10)
            pl:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() Page.CanvasSize = UDim2.new(0, 0, 0, pl.AbsoluteContentSize.Y + 10) end)

            table.insert(subList, {btn = sBtn, page = Page, indicator = sIndicator})

            local function activateSub()
                if window.currentSub then
                    window.currentSub.page.Visible = false
                    Tween(window.currentSub.btn, {0.3}, {BackgroundTransparency = 0.95, TextColor3 = C.Text})
                    Tween(window.currentSub.indicator, {0.3}, {Size = UDim2.new(0, 2, 0, 0)})
                end
                Page.Visible = true
                Tween(sBtn, {0.3}, {BackgroundTransparency = 0.88, TextColor3 = C.TextHi})
                Tween(sIndicator, {0.3}, {Size = UDim2.new(0, 2, 0, 18)})
                window.currentSub = {btn = sBtn, page = Page, indicator = sIndicator}
            end
            sBtn.MouseButton1Click:Connect(activateSub)

            local subObj = { activate = activateSub }
            function subObj:Section(txt)
                local Sec = Instance.new("Frame", Page); Sec.Size = UDim2.new(1, -10, 0, 45); Sec.BackgroundColor3 = Color3.fromRGB(255,255,255); Sec.BackgroundTransparency = 0.97; Instance.new("UICorner", Sec).CornerRadius = UDim.new(0, 10)
                local T = Instance.new("TextLabel", Sec); T.Size = UDim2.new(1, -20, 0, 30); T.Position = UDim2.new(0, 10, 0, 5); T.Text = txt:upper(); T.TextColor3 = C.Accent; T.Font = Enum.Font.GothamBold; T.TextSize = 11; T.TextXAlignment = Enum.TextXAlignment.Left; T.BackgroundTransparency = 1
                local Box = Instance.new("Frame", Sec); Box.Name = "Container"; Box.Size = UDim2.new(1, -20, 0, 0); Box.Position = UDim2.new(0, 10, 0, 35); Box.BackgroundTransparency = 1
                local bl = Instance.new("UIListLayout", Box); bl.Padding = UDim.new(0, 8)
                bl:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() Sec.Size = UDim2.new(1, -10, 0, bl.AbsoluteContentSize.Y + 45) end)
                local e = {}
                function e:Button(t, cb)
                    local b = Instance.new("TextButton", Box); b.Size = UDim2.new(1, 0, 0, 34); b.BackgroundColor3 = Color3.fromRGB(255,255,255); b.BackgroundTransparency = 0.92; b.Text = t; b.TextColor3 = C.TextHi; b.Font = Enum.Font.GothamMedium; b.TextSize = 13; Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
                    b.MouseButton1Click:Connect(function() if cb then cb() end end)
                    return b
                end
                function e:Toggle(t, cb)
                    local b = Instance.new("TextButton", Box); b.Size = UDim2.new(1, 0, 0, 34); b.BackgroundTransparency = 1; b.Text = "  " .. t; b.TextColor3 = C.Text; b.Font = Enum.Font.GothamMedium; b.TextSize = 13; b.TextXAlignment = Enum.TextXAlignment.Left
                    local d = Instance.new("Frame", b); d.Size = UDim2.new(0, 32, 0, 16); d.Position = UDim2.new(1, -40, 0.5, -8); d.BackgroundColor3 = Color3.fromRGB(40,40,40); Instance.new("UICorner", d).CornerRadius = UDim.new(1, 0)
                    local dot = Instance.new("Frame", d); dot.Size = UDim2.new(0, 12, 0, 12); dot.Position = UDim2.new(0, 2, 0.5, -6); dot.BackgroundColor3 = Color3.fromRGB(150,150,150); Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
                    local s = false
                    b.MouseButton1Click:Connect(function()
                        s = not s
                        Tween(dot, {0.25}, {Position = s and UDim2.new(0, 18, 0.5, -6) or UDim2.new(0, 2, 0.5, -6), BackgroundColor3 = s and C.Accent or Color3.fromRGB(150,150,150)})
                        Tween(d, {0.25}, {BackgroundColor3 = s and Color3.fromRGB(60,40,50) or Color3.fromRGB(40,40,40)})
                        if cb then cb(s) end
                    end)
                    return {Set = function(_, v) s = v; Tween(dot, {0.2}, {Position = s and UDim2.new(0, 18, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)}) end}
                end
                function e:Textbox(p, d, cb)
                    local b = Instance.new("TextBox", Box); b.Size = UDim2.new(1, 0, 0, 34); b.BackgroundColor3 = Color3.fromRGB(0,0,0); b.BackgroundTransparency = 0.8; b.Text = d or ""; b.PlaceholderText = p; b.TextColor3 = C.TextHi; b.Font = Enum.Font.GothamMedium; b.TextSize = 13; Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
                    b.FocusLost:Connect(function() if cb then cb(b.Text) end end)
                    return b
                end
                return e
            end
            function subObj:List(txt, data_func, select_cb)
                local sec_elements = self:Section(txt)
                local realBox
                local function findContainer()
                    for _, v in pairs(Page:GetChildren()) do if v.Name == "Section_" .. txt then return v:FindFirstChild("Container") end end
                end
                local function Refresh()
                    realBox = realBox or findContainer()
                    if realBox then
                        for _, child in pairs(realBox:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
                        local refBtn = sec_elements:Button("🔄 重新掃描名單", Refresh)
                        refBtn.TextColor3 = C.Accent
                        for _, n in pairs(data_func()) do sec_elements:Button(n, function() if select_cb then select_cb(n) end end) end
                    end
                end
                task.delay(0.2, Refresh)
                return {Refresh = Refresh}
            end
            return subObj
        end

        mBtn.MouseButton1Click:Connect(function()
            if window.currentMain and window.currentMain.btn == mBtn then return end
            if window.currentMain then
                Tween(window.currentMain.btn, {0.3}, {TextColor3 = C.Text})
                Tween(window.currentMain.line, {0.3}, {Size = UDim2.new(0, 0, 0, 2)})
                for _, item in pairs(window.currentMain.subs) do item.btn.Visible = false; item.page.Visible = false end
            end
            Tween(mBtn, {0.3}, {TextColor3 = C.TextHi})
            Tween(mLine, {0.3}, {Size = UDim2.new(0, 40, 0, 2)})
            window.currentMain = {btn = mBtn, subs = subList, line = mLine}
            task.defer(function()
                for _, item in pairs(subList) do item.btn.Visible = true end
                if subList[1] then 
                    if window.currentSub then
                        window.currentSub.page.Visible = false
                        Tween(window.currentSub.btn, {0.3}, {BackgroundTransparency = 0.95, TextColor3 = C.Text})
                        Tween(window.currentSub.indicator, {0.3}, {Size = UDim2.new(0, 2, 0, 0)})
                    end
                    local firstSub = subList[1]
                    firstSub.page.Visible = true
                    Tween(firstSub.btn, {0.3}, {BackgroundTransparency = 0.88, TextColor3 = C.TextHi})
                    Tween(firstSub.indicator, {0.3}, {Size = UDim2.new(0, 2, 0, 18)})
                    window.currentSub = firstSub
                end
            end)
        end)
        return mainInst
    end

    local dragging, dragStart, startPos
    Main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; dragStart = input.Position; startPos = Main.Position end
    end)
    services.UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    services.UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)

    return window
end

return library
