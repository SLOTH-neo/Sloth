task.spawn(function()
    local Camera = workspace.CurrentCamera
    local lastFakeLag = tick()

    RunService.RenderStepped:Connect(function()
        if not _G.NekoRunning then return end
        pcall(function()
            Camera.FieldOfView = _G.Settings.FOV
            localPlayer.CameraMaxZoomDistance = _G.Settings.MaxZoom
            localPlayer.CameraMinZoomDistance = 0

            local char = localPlayer.Character
            if not char or not char:FindFirstChild("Humanoid") then return end
            local hum = char.Humanoid
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            if _G.Settings.SpeedEnabled then
                hum.WalkSpeed = _G.Settings.CatSpeedValue
            end

            if _G.Settings.NoClip then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end

            if _G.Settings.AirWalk then
                if not parts.AirWalkPart then
                    local p = Instance.new("Part")
                    p.Size = Vector3.new(20, 1, 20)
                    p.Transparency = 1
                    p.Anchored = true
                    p.CanCollide = true
                    p.Parent = Workspace
                    parts.AirWalkPart = p
                end
                parts.AirWalkPart.CFrame = hrp.CFrame * CFrame.new(0, -3.05, 0)
            elseif parts.AirWalkPart then
                parts.AirWalkPart:Destroy()
                parts.AirWalkPart = nil
            end

            if _G.Settings.FakeLag then
                if tick() - lastFakeLag > _G.Settings.FakeLagDelay then
                    hrp.Anchored = true
                    task.wait(0.03)
                    hrp.Anchored = false
                    lastFakeLag = tick()
                end
            end
        end)
    end)
end)

local spinAV
local function updateSpin()
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    if _G.Settings.Spin then
        if not spinAV then
            spinAV = Instance.new("BodyAngularVelocity")
            spinAV.MaxTorque = Vector3.new(0, math.huge, 0)
            spinAV.AngularVelocity = Vector3.new(0, _G.Settings.SpinSpeed, 0)
            spinAV.Parent = hrp
        end
        spinAV.AngularVelocity = Vector3.new(0, _G.Settings.SpinSpeed, 0)
    else
        if spinAV then spinAV:Destroy() spinAV = nil end
    end
end

local flingCon
local function updateFling()
    if _G.Settings.Fling then
        if flingCon then return end
        flingCon = RunService.Heartbeat:Connect(function()
            pcall(function()
                local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local targetHRP = p.Character.HumanoidRootPart
                        if (hrp.Position - targetHRP.Position).Magnitude < 15 then
                            local oldVel = hrp.Velocity
                            hrp.Velocity = Vector3.new(0, 1e5, 0)
                            task.wait()
                            hrp.Velocity = oldVel
                            targetHRP.AssemblyAngularVelocity = Vector3.new(math.random(-1000,1000), math.random(-1000,1000), math.random(-1000,1000))
                        end
                    end
                end
            end)
        end)
    else
        if flingCon then flingCon:Disconnect() flingCon = nil end
    end
end

local invisCon, invisPart
local function updateInvisible()
    local char = localPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if _G.Settings.Invisible then
        if not invisPart then
            invisPart = Instance.new("Part")
            invisPart.Size = Vector3.new(1,1,1)
            invisPart.Transparency = 1
            invisPart.Anchored = true
            invisPart.CanCollide = false
            invisPart.Parent = Workspace
        end

        if not invisCon then
            invisCon = RunService.RenderStepped:Connect(function()
                if invisPart then
                    invisPart.CFrame = hrp.CFrame
                end
                workspace.CurrentCamera.CameraSubject = invisPart
            end)
        end

        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("MeshPart") or part:IsA("Decal") then
                part.Transparency = 1
            end
        end
    else
        if invisCon then invisCon:Disconnect() invisCon = nil end
        if invisPart then invisPart:Destroy() invisPart = nil end
        workspace.CurrentCamera.CameraSubject = char:FindFirstChildOfClass("Humanoid")
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("MeshPart") then
                part.Transparency = 0
            elseif part:IsA("Decal") then
                part.Transparency = part:GetAttribute("OriginalTransparency") or 0
            end
        end
    end
end

